<div class="sheet">
  <PaperComponents.masthead date={@date} dateline={@dateline} edition={@edition} />

  <main class="page">
    <PaperComponents.section_band section={@edition.section} kicker={@edition.kicker} />
    <PaperComponents.lead_story story={@edition.story} edition={@edition} />
  </main>

  <PaperComponents.colophon edition={@edition} />
</div>
