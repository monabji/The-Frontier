<div class="sheet">
  <PaperComponents.masthead date={@date} />

  <main class="page">
    <PaperComponents.section_band
      section="Front Page"
      kicker={"Hacker News · #{length(@items)} stories"}
    />
    <PaperComponents.front_page items={@items} />
  </main>

  <PaperComponents.colophon />
</div>
